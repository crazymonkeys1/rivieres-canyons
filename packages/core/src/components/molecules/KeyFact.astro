---
// L4 KeyFact: a "good to know" tile (icon + label + value). The value is content: body ink, may wrap.
import Icon from '../atoms/Icon.astro';
interface Props { label: string; value: string; emoji?: string; icon?: import('../atoms/icons').IconName }
const { label, value, emoji, icon } = Astro.props;
---
<div class:list={['key-fact', { 'key-fact--icon': emoji || icon }]}>
  {(emoji || icon) && <Icon emoji={emoji} name={icon} size={24} class="key-fact__icon" />}
  <dt class="text-label key-fact__label">{label}</dt>
  <dd class="text-body key-fact__value">{value}<slot name="note" /></dd>
</div>
<style>
  /* dt and dd stay direct children of the div (valid <dl> structure); the icon sits in the left gutter. */
  .key-fact { --key-fact-icon: 24px; position: relative; display: grid; gap: var(--space-0h); padding: var(--space-3) var(--space-4); background: var(--color-surface-inset); border: 1px solid var(--color-border-default); border-radius: var(--radius-control); }
  .key-fact--icon { padding-inline-start: calc(var(--space-4) + var(--key-fact-icon) + var(--space-3)); }
  .key-fact :global(.key-fact__icon) { position: absolute; inset-block-start: var(--space-3); inset-inline-start: var(--space-4); }
  .key-fact__label { color: var(--color-text-muted); }
  .key-fact__value { margin: 0; color: var(--color-text-body); }
</style>
