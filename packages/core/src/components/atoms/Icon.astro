---
// L3 Icon: an SVG line icon (by name) or an emoji (by symbol), as the site's icon_style decides (B2).
// Always decorative (aria-hidden) and followed by text; the meaning is carried by that text.
import { ICONS, type IconName } from './icons';
interface Props { name?: IconName; emoji?: string; size?: 15 | 17 | 24 | 32; framed?: boolean; class?: string }
const { name, emoji, size = 17, framed = false, class: cls } = Astro.props;
if (!name && !emoji) throw new Error('Icon: give a name (SVG) or an emoji');
---
<span class:list={['icon', { 'icon--framed': framed }, cls]} style={`--icon-size: ${size}px`} aria-hidden="true">
  {emoji ? <span class="icon__emoji">{emoji}</span> : (
    <svg viewBox="0 0 24 24" width="100%" height="100%" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" focusable="false"><path d={ICONS[name!]} /></svg>
  )}
</span>
<style>
  .icon { display: inline-grid; place-items: center; inline-size: var(--icon-size); block-size: var(--icon-size); flex: none; }
  .icon__emoji { font-size: calc(var(--icon-size) * 0.9); /* design-check-allow: an emoji is a picture sized to its box, not text */ line-height: 1; /* design-check-allow: same */ }
  .icon--framed { --icon-frame: 32px; inline-size: var(--icon-frame); block-size: var(--icon-frame); background: var(--color-surface-card); border: 1px solid var(--color-border-default); border-radius: var(--radius-tag); }
  .icon--framed svg, .icon--framed .icon__emoji { inline-size: var(--icon-size); block-size: var(--icon-size); }
</style>
