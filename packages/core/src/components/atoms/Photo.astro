---
// L3 Photo: a content photo at a fixed ratio, served from the site (resized by Astro), or a neutral
// placeholder while the file has not been downloaded. Never a hotlink. The credit is shown by the parent.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Props {
  image: ImageMetadata | null; alt: string; ratio?: '4:3' | '3:2' | '16:9' | '1:1' | '21:9';
  widths?: number[]; sizes?: string; eager?: boolean; placeholderLabel?: string; class?: string;
}
const { image, alt, ratio = '4:3', widths = [360, 720, 1080], sizes = '(min-width: 1024px) 50vw, 100vw', eager, placeholderLabel, class: cls } = Astro.props;
---
<span class:list={['photo', cls]} style={`--photo-ratio: ${ratio.replace(':', ' / ')}`}>
  {image
    ? <Image src={image} alt={alt} widths={widths} sizes={sizes} loading={eager ? 'eager' : 'lazy'} fetchpriority={eager ? 'high' : undefined} class="photo__img" />
    : <span class="photo__placeholder text-label" {...(alt ? { role: 'img', 'aria-label': alt } : { 'aria-hidden': 'true' })}>{placeholderLabel}</span>}
</span>
<style>
  .photo { display: block; position: relative; aspect-ratio: var(--photo-ratio); overflow: hidden; background: var(--color-surface-sunken); }
  .photo__img { display: block; inline-size: 100%; block-size: 100%; object-fit: cover; }
  .photo__placeholder { display: grid; place-items: center; block-size: 100%; padding: var(--space-2); color: var(--color-text-muted); text-align: center; }
</style>
