---
// L3 Badge: a short status or category on a card or photo. Never a sentence.
// tone "danger" is the round "!" mark of safety content; give it a label for screen readers.
interface Props { tone?: 'neutral' | 'danger' | 'info'; onPhoto?: boolean; label?: string; class?: string }
const { tone = 'neutral', onPhoto, label, class: cls } = Astro.props;
---
{tone === 'danger' ? (
  <span class:list={['badge', 'badge--danger', 'text-body', 'is-strong', cls]} role="img" aria-label={label}>!</span>
) : (
  <span class:list={['badge', 'text-label', 'is-strong', `badge--${tone}`, { 'badge--on-photo': onPhoto }, cls]}><slot /></span>
)}
<style>
  .badge { display: inline-flex; align-items: center; gap: var(--space-1); padding: var(--space-0h) var(--space-2); border-radius: var(--radius-full); white-space: nowrap; }
  .badge--neutral { background: var(--color-surface-sunken); color: var(--color-text-strong); }
  .badge--info { background: var(--color-surface-info); color: var(--color-text-strong); }
  .badge--on-photo { background: var(--color-surface-on-photo); color: var(--color-text-strong); }
  .badge--danger { --badge-danger-size: 24px; flex: none; inline-size: var(--badge-danger-size); block-size: var(--badge-danger-size); justify-content: center; padding: 0; border-radius: 50%; background: var(--color-status-danger); color: var(--color-text-inverse); }
</style>
