---
// L5 SiteHeader: wordmark, then the menu button on phones or the inline nav from 1024px. Not sticky.
// The MenuSheet it opens is passed in the "menu" slot (organisms compose organisms through slots, never imports).
interface Props { homeHref: string; name: string; mark: string; links: { label: string; href: string }[]; menuLabel: string; menuId: string; onPhoto?: boolean }
const { homeHref, name, mark, links, menuLabel, menuId, onPhoto } = Astro.props;
---
<header class:list={['site-header', { 'site-header--on-photo': onPhoto }]}>
  <a class="site-header__brand" href={homeHref}>
    <span class="site-header__mark text-caption is-strong" aria-hidden="true">{mark}</span>
    <span class="site-header__name text-title">{name}</span>
  </a>
  <nav class="site-header__nav" aria-label={menuLabel}>
    {links.map((l) => <a class="site-header__link text-body is-strong" href={l.href}>{l.label}</a>)}
  </nav>
  <button type="button" class="site-header__menu" aria-label={menuLabel} aria-haspopup="dialog" aria-controls={menuId} aria-expanded="false" data-menu-open={menuId}>
    <span class="site-header__lines" aria-hidden="true"></span>
  </button>
  <slot name="menu" />
</header>
<style>
  .site-header { display: flex; align-items: center; justify-content: space-between; gap: var(--space-4); padding: var(--space-2) var(--page-gutter); background: var(--color-surface-page); border-block-end: 1px solid var(--color-border-default); }
  .site-header__brand { display: inline-flex; align-items: center; gap: var(--space-2h); min-block-size: var(--tap-size-min); color: var(--color-text-strong); }
  .site-header__brand:hover { color: var(--color-text-strong); }
  .site-header__mark { --mark-size: 32px; display: grid; place-items: center; inline-size: var(--mark-size); block-size: var(--mark-size); border-radius: var(--radius-tag); background: var(--color-surface-inverse-strong); color: var(--color-text-inverse); }
  .site-header__nav { display: none; gap: var(--space-6); }
  .site-header__link { display: inline-flex; align-items: center; min-block-size: var(--tap-size-min); color: var(--color-text-strong); }
  .site-header__link:hover { color: var(--color-brand); }
  .site-header__menu { display: grid; place-items: center; inline-size: var(--tap-size-min); block-size: var(--tap-size-min); margin-inline-end: calc(var(--space-2h) * -1); padding: 0; border: 0; border-radius: 50%; background: none; color: var(--color-text-strong); cursor: pointer; }
  .site-header__menu:hover { background: var(--color-surface-sunken); }
  .site-header__lines { --line-width: 20px; display: block; inline-size: var(--line-width); block-size: var(--space-2); border-block: 2px solid currentColor; }
  @media (min-width: 1024px) {
    .site-header__nav { display: flex; }
    .site-header__menu { display: none; }
  }
</style>
