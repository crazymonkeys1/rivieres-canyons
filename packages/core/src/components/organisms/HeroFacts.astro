---
// L5 HeroFacts: the key facts of a place, built once. In the page body on phones; from 1024px they float over the
// bottom edge of the hero. Cells (FactCell) come in the slot.
interface Props { label: string }
const { label } = Astro.props;
---
<div class="hero-facts"><dl class="hero-facts__list" aria-label={label}><slot /></dl></div>
<style>
  .hero-facts { inline-size: 100%; max-inline-size: var(--container-page); margin-inline: auto; padding: var(--space-4) var(--page-gutter) 0; }
  .hero-facts__list { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1px; margin: 0; background: var(--color-border-default); border: 1px solid var(--color-border-default); border-radius: var(--radius-container); overflow: hidden; }
  .hero-facts__list > :global(:last-child:nth-child(odd)) { grid-column: 1 / -1; }
  @media (min-width: 480px) {
    .hero-facts__list { grid-template-columns: repeat(3, 1fr); }
    .hero-facts__list > :global(:last-child:nth-child(odd)) { grid-column: auto; }
  }
  @media (min-width: 1024px) {
    .hero-facts { position: relative; z-index: var(--z-float); margin-block-start: calc(var(--space-10) * -1); padding-block-start: 0; }
    .hero-facts__list { display: inline-flex; flex-wrap: wrap; box-shadow: var(--elevation-overlap); }
  }
</style>
