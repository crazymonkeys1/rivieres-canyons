---
// L5 Gallery: photos grouped by kind ("Sur place", "En sortie guidée"), 4:3 thumbnails. Each thumbnail links to
// the large photo (works without JavaScript); the Lightbox enhances it. Photos not downloaded yet show a placeholder.
import type { ImageMetadata } from 'astro';
import Photo from '../atoms/Photo.astro';
interface Item { image: ImageMetadata | null; full: string | null; alt: string; caption: string; sourceHref?: string | null }
interface Props { groups: { title: string; items: Item[] }[]; placeholderLabel: string; group: string }
const { groups, placeholderLabel, group } = Astro.props;
---
<div class="gallery" data-lightbox-group={group}>
  {groups.filter((g) => g.items.length).map((g) => (
    <div class="gallery__group">
      <h3 class="text-subheading gallery__title">{g.title}</h3>
      <ul class="gallery__grid">
        {g.items.map((it) => (
          <li>{it.image && it.full
            ? <a class="gallery__item" href={it.full} data-lightbox-item data-caption={it.caption} data-source={it.sourceHref ?? ''}><Photo image={it.image} alt={it.alt} ratio="4:3" widths={[240, 480]} sizes="(min-width: 1024px) 200px, 50vw" /></a>
            : <span class="gallery__item"><Photo image={null} alt={it.alt} ratio="4:3" placeholderLabel={placeholderLabel} /></span>}
          </li>
        ))}
      </ul>
    </div>
  ))}
  <slot />
</div>
<style>
  .gallery { display: grid; gap: var(--space-5); }
  .gallery__title { margin: 0 0 var(--space-2); color: var(--color-text-strong); }
  .gallery__grid { --gallery-min: 160px; display: grid; grid-template-columns: repeat(2, 1fr); gap: var(--space-2); margin: 0; padding: 0; list-style: none; }
  .gallery__item { display: block; border-radius: var(--radius-control); overflow: hidden; }
  .gallery__item :global(.photo__img) { transition: transform var(--duration-base) var(--easing-standard); }
  a.gallery__item:hover :global(.photo__img) { transform: scale(1.03); }
  @media (min-width: 480px) { .gallery__grid { grid-template-columns: repeat(auto-fill, minmax(var(--gallery-min), 1fr)); } }
</style>
