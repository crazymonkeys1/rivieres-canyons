---
// L5 KeyFacts: the "good to know" tiles (KeyFact molecules in the slot), as many columns as fit.
interface Props { label?: string }
const { label } = Astro.props;
---
<dl class="key-facts" aria-label={label}><slot /></dl>
<style>
  .key-facts { --key-facts-min: 240px; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, var(--key-facts-min)), 1fr)); gap: var(--space-2); margin: 0; }
</style>
