---
// L6 DocumentTemplate: a plain text page (privacy, legal notice, about, contact), no content: H1 area, then prose in the
// reading column (--container-read). Sections are <section> with an H2. Slots, in order: header · default · after
---
<div class="document-template">
  <div class="document-template__column">
    <header class="document-template__header"><slot name="header" /></header>
    <slot />
  </div>
  <slot name="after" />
</div>
<style>
  .document-template__column { display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--space-6); inline-size: 100%; max-inline-size: calc(var(--container-read) + 2 * var(--page-gutter)); margin-inline: auto; padding: var(--space-8) var(--page-gutter) var(--section-y); }
  .document-template__column > :global(*), .document-template__header > :global(*) { margin: 0; }
  .document-template__header { display: grid; gap: var(--space-2); }
  .document-template__column > :global(section) { display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--space-3); scroll-margin-top: var(--space-6); }
  .document-template__column > :global(section) > :global(*) { margin: 0; }
  .document-template :global(.document-template__actions) { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-2) var(--space-4); }
</style>
