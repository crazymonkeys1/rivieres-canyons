---
// L5 GuideSection: who runs the site ("Qui sommes-nous"): the guides' portraits, a short text, one block per company
// with its guide, credential, description and contact links. On a dark band.
import Avatar from '@orbit/core/components/atoms/Avatar.astro';
import TextLink from '@orbit/core/components/atoms/TextLink.astro';
import type { ImageMetadata } from 'astro';
interface Company { name: string; withLine: string; credential: string; text: string; color: string; portrait?: ImageMetadata | null; guideName: string; write: { label: string; href: string }; profile: { label: string; href: string }; website: { label: string; href: string } }
interface Props { eyebrow: string; title: string; paragraphs: string[]; companies: Company[]; id?: string }
const { eyebrow, title, paragraphs, companies, id } = Astro.props;
---
<section class="guide-section" aria-labelledby={id}>
  <div class="guide-section__panel">
    <p class="text-label is-upper guide-section__eyebrow">{eyebrow}</p>
    <div class="guide-section__avatars">{companies.map((c) => <Avatar src={c.portrait?.src} alt={c.guideName} size={44} ring />)}</div>
    <h2 class="text-heading guide-section__title" id={id}>{title}</h2>
    {paragraphs.map((p) => <p class="text-read guide-section__text">{p}</p>)}
    <div class="guide-section__companies">
      {companies.map((c) => (
        <div class="guide-section__company" style={`--operator-color: ${c.color}`}>
          <p class="text-body is-strong guide-section__name">{c.name}</p>
          <p class="text-caption is-strong guide-section__with">{c.withLine}</p>
          <p class="text-caption guide-section__credential">{c.credential}</p>
          <p class="text-caption guide-section__company-text">{c.text}</p>
          <p class="guide-section__links"><TextLink href={c.write.href} external>{c.write.label}</TextLink><TextLink href={c.profile.href}>{c.profile.label}</TextLink></p>
          <TextLink href={c.website.href} emphasis="quiet" external>{c.website.label} ↗</TextLink>
        </div>
      ))}
    </div>
  </div>
</section>
<style>
  .guide-section { padding: var(--space-10) var(--page-gutter); background: var(--color-surface-inverse-strong); }
  .guide-section__panel { display: grid; gap: var(--space-3); max-inline-size: var(--container-article); margin-inline: auto; padding: var(--space-6) var(--space-5); background: var(--color-surface-card); border-radius: var(--radius-container); }
  .guide-section p { margin: 0; }
  .guide-section__eyebrow { color: var(--color-brand); }
  .guide-section__avatars { display: flex; }
  .guide-section__avatars > :global(* + *) { margin-inline-start: calc(var(--space-2h) * -1); }
  .guide-section__title { margin: 0; color: var(--color-text-strong); }
  .guide-section__text { color: var(--color-text-body); }
  .guide-section__companies { --company-min: 240px; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, var(--company-min)), 1fr)); gap: var(--space-2h); margin-block-start: var(--space-2); }
  .guide-section__company { display: grid; gap: var(--space-1); align-content: start; padding: var(--space-4); border: 1px solid var(--color-border-default); border-radius: var(--radius-container); }
  .guide-section__name { color: var(--color-text-strong); }
  .guide-section__with { color: var(--operator-color); }
  .guide-section__credential { color: var(--color-text-muted); }
  .guide-section__company-text { color: var(--color-text-body); }
  .guide-section__links { display: flex; flex-wrap: wrap; gap: 0 var(--space-4); }
</style>
