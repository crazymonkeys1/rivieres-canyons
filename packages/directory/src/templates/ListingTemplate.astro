---
// L6 ListingTemplate: hero · filters · notice · results header · results (cards and the lead capture) · empty state.
// Layout only: the results are a responsive card grid (one column on phones).
---
<div class="listing-template">
  <slot name="hero" />
  <slot name="filters" />
  <div class="listing-template__body">
    <slot name="notice" />
    <div class="listing-template__header"><slot name="header" /></div>
    <ul class="listing-template__results" data-results><slot /></ul>
    <slot name="empty" />
  </div>
  <slot name="after" />
</div>
<style>
  .listing-template__body { display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--space-4); max-inline-size: var(--container-page); margin-inline: auto; padding: var(--space-4) var(--page-gutter) var(--space-10); }
  .listing-template__header { display: flex; justify-content: space-between; align-items: center; gap: var(--space-2); }
  .listing-template__results { --card-min: 290px; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, var(--card-min)), 1fr)); gap: var(--space-4); margin: 0; padding: 0; list-style: none; }
  .listing-template__results > :global(li[hidden]) { display: none; }
  .listing-template__results > :global(.is-full) { grid-column: 1 / -1; }
  .listing-template__results > :global(li > *) { block-size: 100%; }
</style>
