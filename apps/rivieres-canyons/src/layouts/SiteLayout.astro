---
// The frame of every public page: foundation CSS + theme, document head, header and menu, footer with the full
// safety disclaimer. Pages give their path only: title, description, indexing, image and JSON-LD come from the page
// registry (src/content/pages.ts), the same source as the sitemap, llms.txt and the Markdown twins.
import '@orbit/core/styles/index.css';
import '../styles/theme.css';
import PageShell from '@orbit/core/templates/PageShell.astro';
import SiteHeader from '@orbit/core/components/organisms/SiteHeader.astro';
import MenuSheet from '@orbit/core/components/organisms/MenuSheet.astro';
import SiteFooter from '@orbit/core/components/organisms/SiteFooter.astro';
import LegalNotice from '@orbit/core/components/organisms/LegalNotice.astro';
import { t, url } from '../content/site';
import { primaryLinks, menuGroups, footerGroups } from '../content/nav';
import { pageMeta, twinPath } from '../content/pages';
interface Props { path: string }
const { path } = Astro.props;
const { title, description, noindex, jsonLd, image, markdown } = await pageMeta(path);
const canonical = new URL(path, Astro.site).href;
---
<PageShell title={title} description={description} canonical={canonical} noindex={noindex} jsonLd={jsonLd} image={image} siteName={t('site.name')} analyticsToken={import.meta.env.PUBLIC_CF_BEACON_TOKEN}>
  {markdown && <link slot="head" rel="alternate" type="text/markdown" href={twinPath(path)} />}
  <SiteHeader homeHref={url.home()} name={t('site.name')} mark={t('site.mark')} links={primaryLinks} menuLabel={t('nav.menu_open')} menuId="site-menu">
    <MenuSheet slot="menu" id="site-menu" label={t('nav.menu_open')} closeLabel={t('nav.menu_close')} primary={primaryLinks} groups={menuGroups} />
  </SiteHeader>
  <main id="contenu"><slot /></main>
  <SiteFooter groups={footerGroups} note={t('footer.independence')} label={t('footer.ideas')}>
    <LegalNotice scope="full" id="avertissement" summary={t('legal.full_summary')} paragraphs={[t('legal.full_1'), t('legal.full_2'), t('legal.full_3'), t('legal.full_4')]} />
  </SiteFooter>
</PageShell>
