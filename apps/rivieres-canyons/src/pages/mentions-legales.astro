---
// L7 Legal notice: the publisher and host block is not written yet (placeholder; the page registry keeps it noindex and a production build fails on it);
// the safety disclaimer below it is the site's existing text.
import SiteLayout from '../layouts/SiteLayout.astro';
import DocumentTemplate from '@orbit/core/templates/DocumentTemplate.astro';
import SectionHeader from '@orbit/core/components/molecules/SectionHeader.astro';
import { t, url } from '../content/site';
---
<SiteLayout path={url.legal()}>
  <DocumentTemplate>
    <h1 slot="header" class="text-display">{t('legal.title')}</h1>
    <p class="text-read">{t('legal.publisher')}</p>
    <section aria-labelledby="avertissement-texte">
      <SectionHeader id="avertissement-texte" title={t('legal.full_summary')} />
      {[t('legal.full_1'), t('legal.full_2'), t('legal.full_3'), t('legal.full_4')].map((p) => <p class="text-read">{p}</p>)}
    </section>
  </DocumentTemplate>
</SiteLayout>
