---
// Dev-only document shell for the style guide (noindex, never in the sitemap). Loads the whole foundation + the site theme.
import '@orbit/core/styles/index.css';
import '../../styles/theme.css';
interface Props { title: string }
const { title } = Astro.props;
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title}</title>
  </head>
  <body><slot /></body>
</html>
